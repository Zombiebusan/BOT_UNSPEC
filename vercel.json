{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/telegram.ts": { "maxDuration": 60, "includeFiles": "node_modules/@fontsource/noto-sans/files/noto-sans-{latin,greek}-{400,700}-normal.woff" },
    "api/unspec-morning.ts": { "maxDuration": 300 }
  },
  "crons": [{ "path": "/api/unspec-morning", "schedule": "0 0 * * *" }]
}
